      const label = item.querySelector(".dock-label")?.textContent.trim();
      if (!label) return;
      hide();
      active = item;
      previousDescription = item.getAttribute("aria-describedby");
      tip.textContent = label;
      tip.hidden = false;
      const box = item.getBoundingClientRect();
      const width = tip.getBoundingClientRect().width;
      const height = tip.getBoundingClientRect().height;
      tip.style.left = `${Math.max(10, Math.min(box.left + box.width / 2 - width / 2, window.innerWidth - width - 10))}px`;
      tip.style.top = `${Math.max(8, box.top - height - 12)}px`;
      item.setAttribute("aria-describedby", [previousDescription, tip.id].filter(Boolean).join(" "));
    }


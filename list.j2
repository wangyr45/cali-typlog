  --room-shelf-wood-front-top: oklch(0.43 0.04 59);
  --room-shelf-wood-grain: rgb(0 0 0 / 0.15);
  --room-shelf-wood-top-back: oklch(0.38 0.035 56);
  --room-shelf-wood-top-front: oklch(0.47 0.035 62);

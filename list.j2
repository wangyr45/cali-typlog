{% macro public_url(value) -%}
  {%- if value is string -%}
    {%- set value = value|trim -%}
    {%- set normalized = value|lower -%}
    {%- if value.split()|join('') == value and '\\' not in value and '\x00' not in value -%}
      {%- if normalized.startswith('https://') or normalized.startswith('http://') -%}
        {%- set authority = value.split('://', 1)[1].split('/', 1)[0].split('?', 1)[0].split('#', 1)[0] -%}
        {%- if authority and not authority.startswith(':') and '@' not in authority -%}{{- value -}}{%- endif -%}
      {%- elif value.startswith('/') and not value.startswith('//') -%}
        {{- value -}}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endmacro %}
{% macro image_url(value) -%}
  {%- if value in bundled_images -%}
    {{- asset_base.rstrip('/') ~ '/assets/' ~ value[6:] -}}
  {%- else -%}{{- public_url(value) -}}{%- endif -%}
{%- endmacro %}
{% set portrait_url = image_url(config.portrait)|trim %}
{% set portrait_url = portrait_url or (site.logo.src if site.logo else '') %}
{% set portrait_dark_url = image_url(config.portrait_dark)|trim or portrait_url %}
{% set dock_portrait_url = site.logo.src if site.logo else '' %}
{% set project_entries = namespace(items=[]) %}
{% for item in config.projects %}
  {% if item.title is string and item.title|trim and public_url(item.url)|trim %}
    {% set project_entries.items = project_entries.items + [item] %}
  {% endif %}
{% endfor %}
{% set config.projects = project_entries.items %}
{% set projects_url = linkify('/') ~ '#projects' %}


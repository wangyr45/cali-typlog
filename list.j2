.vinyl-room {
  --vinyl-depth: 3px;
  --vinyl-motion-duration: 330ms;
  --vinyl-shadow-rgb: var(--room-shelf-shadow-rgb);

  left: 50%;
  width: min(37.5rem, calc(100vw - 2rem));
  isolation: isolate;
  transform: translateX(-50%);
}

.vinyl-annotation {
  z-index: 2;
}

.vinyl-viewport {
  position: relative;
  z-index: 2;
  overflow: clip;
  cursor: grab;
}

.vinyl-room[data-vinyl-interaction='panning'] .vinyl-viewport {
  cursor: grabbing;
}

.vinyl-shelf {
  --vinyl-spread: 48%;

  display: grid;
  place-items: end center;
  margin: 0;
  padding: 1rem 0 4px;
  list-style: none;
  overflow: visible;
  isolation: isolate;
  perspective: 900px;
  perspective-origin: center bottom;
}

.vinyl {
  position: relative;
  grid-area: 1 / 1;
  width: clamp(7.25rem, 27vw, 9.5rem);
  z-index: var(--vinyl-stack-order);
  pointer-events: none;
}

.vinyl-trigger {
  display: block;
  position: relative;
  width: 100%;
  min-width: 44px;
  min-height: 44px;
  padding: 0;
  border: 0;
  color: inherit;
  background: transparent;
  cursor: default;
  pointer-events: none;
  touch-action: manipulation;
  transform: translateX(calc(var(--vinyl-offset) * var(--vinyl-spread)))
    translateY(calc(var(--vinyl-rest-offset) * 1px))
    translateZ(calc(var(--vinyl-forward) * 1px))
    rotateZ(calc(var(--vinyl-rest-tilt) * 1deg))
    rotateY(calc(var(--vinyl-direction) * var(--vinyl-inward-angle) * -1deg))
    scale(var(--vinyl-scale));
  transform-origin: var(--vinyl-origin-x) bottom;
  transform-style: preserve-3d;
  transition: transform var(--vinyl-motion-duration) var(--ease-spring);
  will-change: transform;
}

/* Pointer ownership follows the rendered sleeve quadrilateral, not each
   transformed button's axis-aligned bounding box. The viewport routes hover,
   drag, wheel, and click through the same selection model. */

.vinyl-hit-corner {
  position: absolute;
  z-index: -1;
  width: 0;
  height: 0;
  pointer-events: none;
}

.vinyl-hit-corner[data-corner='top-left'] {
  top: 0;
  left: 0;
}

.vinyl-hit-corner[data-corner='top-right'] {
  top: 0;
  right: 0;
}

.vinyl-hit-corner[data-corner='bottom-right'] {
  right: 0;
  bottom: 0;
}

.vinyl-hit-corner[data-corner='bottom-left'] {
  bottom: 0;
  left: 0;
}

.vinyl-object {
  position: relative;
  z-index: 1;
  display: block;
  width: 100%;
  transform: translate(0, 0);
  transform-style: preserve-3d;
  transition: transform var(--vinyl-motion-duration) var(--ease-spring);
}

.vinyl-contact-shadow {
  position: absolute;
  z-index: 0;
  top: calc(100% - 5px);
  right: 8%;
  left: 8%;
  height: 10px;
  border-radius: 50%;
  background: radial-gradient(
    ellipse at center,
    rgb(var(--vinyl-shadow-rgb) / 0.4) 0%,
    rgb(var(--vinyl-shadow-rgb) / 0.18) 46%,
    transparent 84%
  );
  opacity: var(--vinyl-contact-opacity);
  pointer-events: none;
  transform: translateZ(-1px)
    rotateY(calc(var(--vinyl-direction) * var(--vinyl-inward-angle) * 1deg))
    rotateX(62deg)
    scaleX(var(--vinyl-contact-scale));
  transform-origin: center;
  transition:
    transform var(--vinyl-motion-duration) var(--ease-spring),
    opacity var(--vinyl-motion-duration) var(--ease-spring);

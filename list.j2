{% block body %}
<div class="cali-shell">
  {{ header() }}
  <main id="cali-main" class="cali-container cali-list" tabindex="-1">
    <header class="cali-page-heading cali-writing-heading">
      {% if page.type == 'tag' %}<h1>{{ page.topic.title }}</h1>{% if page.topic.summary %}<p>{{ page.topic.summary }}</p>{% endif %}
      {% elif page.type == 'author' %}<h1>{{ page.topic.name }}</h1>
      {% elif page.type == 'lang' %}<h1>{{ page.topic.name }}</h1>
      {% elif page.type == 'audio_list' and site.podcast %}
        <h1>{{ site.podcast.title or page.title }}</h1>
        {% if site.podcast.subtitle %}<p>{{ site.podcast.subtitle }}</p>{% endif %}
      {% else %}<h1>{{ labels.recent if page.type in ['post_list', 'list'] else page.title|default(labels.archive, true) }}</h1>{% endif %}
      {% if page.type == 'audio_list' and site.podcast %}
        <nav class="cali-podcast-links" aria-label="{{ '订阅播客' if zh else 'Subscribe to podcast' }}">
          <a href="{{ linkify('/feed/audio.xml') }}">RSS ↗</a>
          {% for nav in site.podcast.links|default([], true) %}
            {% if public_url(nav.url)|trim %}{{ nav_link(nav) }}{% endif %}
          {% endfor %}
        </nav>
      {% endif %}
    </header>
    {{ writing_list(page.items) }}
    {% if page.prev_url or page.next_url %}
    <nav class="cali-pagination" aria-label="Pagination">
      {% if page.prev_url %}<a href="{{ linkify(page.prev_url) }}">← {{ labels.previous }}{% if page.prev_year %} · {{ page.prev_year }}{% endif %}</a>{% endif %}
      {% if page.next_url %}<a href="{{ linkify(page.next_url) }}">{{ labels.next }}{% if page.next_year %} · {{ page.next_year }}{% endif %} →</a>{% endif %}
    </nav>
    {% endif %}
    {% if page.years and page.base_url %}<nav class="cali-years" aria-label="Years">{% for year in page.years|reverse %}<a href="{{ linkify(page.base_url ~ year ~ '/') }}"{% if page.year == year %} aria-current="page"{% endif %}>{{ year }}</a>{% endfor %}</nav>{% endif %}
  </main>
  {{ footer() }}
</div>
{% endblock %}

/* Contact cards share the site's paper, type, and restrained depth. */
.cali-contact-card {
  position:fixed; z-index:90; width:320px; max-width:calc(100vw - 24px);
  max-height:calc(100dvh - 24px); overflow:auto; padding:0 20px;
  border:1px solid var(--border); border-radius:8px;
  background:var(--background); color:var(--foreground);
  box-shadow:0 12px 36px #00000012,0 2px 5px #00000008;
  font:13px/1.65 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  animation:contact-card-in 160ms ease-out;
}
.cali-contact-card[hidden] { display:none; }
.contact-card-masthead { display:flex; justify-content:space-between; align-items:center; height:42px; border-bottom:1px solid var(--border); color:var(--muted-foreground); }
.contact-card-service { font-size:10px; letter-spacing:.1em; text-transform:uppercase; }
.contact-card-edition { font:12px/1.4 ui-monospace,monospace; }
.contact-card-head { display:flex; align-items:center; gap:11px; margin-top:20px; }
.contact-card-avatar { position:relative; flex:none; width:42px; height:42px; display:grid; place-items:center; border-radius:50%; overflow:hidden; background:var(--gray-2); font-size:20px; }
.contact-card-avatar img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
.contact-card-names { display:flex; flex-direction:column; min-width:0; gap:1px; flex:1; }
.contact-card-name { font-size:16px; font-weight:550; line-height:1.4; overflow-wrap:anywhere; }
.contact-card-handle { font:11px/1.6 ui-monospace,monospace; color:var(--muted-foreground); overflow-wrap:anywhere; }
.contact-card-glyph { flex:none; width:22px; height:22px; font-size:22px; color:var(--muted-foreground); }
.contact-card-bio { margin:18px 0 20px; font-size:14px; line-height:1.85; white-space:pre-line; overflow-wrap:anywhere; }
.contact-card-foot { display:flex; flex-direction:column; gap:3px; padding:13px 0 15px; border-top:1px solid var(--border); color:var(--muted-foreground); font-size:11px; }
.contact-card-destination { font:10px/1.6 ui-monospace,monospace; opacity:.75; overflow-wrap:anywhere; }

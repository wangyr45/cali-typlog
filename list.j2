(() => {
  "use strict";

  const dock = document.querySelector(".dock");
  if (dock) {
    const tip = document.createElement("span");
    tip.className = "cali-floating-tip";
    tip.id = "cali-dock-tip";
    tip.setAttribute("role", "tooltip");
    tip.hidden = true;
    document.body.append(tip);

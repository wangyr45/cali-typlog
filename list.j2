<button type="button" data-cali-appearance="dark" aria-label="{{ '深色' if zh else 'Dark' }}" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"/></svg>{{ '深色' if zh else 'Dark' }}</button>
</div></div></div>
{% if features.algolia %}<input class="js-search cali-search" type="search" aria-label="{{ labels.search }}" placeholder="{{ labels.search }}…" autocomplete="off">{% endif %}
{% if features.subscriber %}<button type="button" class="js-subscribe cali-menu-subscribe">{{ icon(1) }}<span>{{ labels.subscribe }}</span><span class="cali-menu-subscribe-arrow" aria-hidden="true">↗</span></button>{% endif %}
{% if site.primary_links|default([], true) %}

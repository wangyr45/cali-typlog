{% macro link_host(url) -%}
  {%- set url = public_url(url)|trim|lower -%}
  {%- if '://' in url -%}{{- url.split('://', 1)[1].split('/', 1)[0].split('?', 1)[0].split('#', 1)[0].split(':', 1)[0].rstrip('.') -}}{%- endif -%}
{%- endmacro %}

{% macro local_path(url) -%}
  {%- set url = public_url(url)|trim -%}
  {%- set host = link_host(url)|trim -%}
  {%- set base = link_host(site.base_url|default(''))|trim -%}
  {%- if host.startswith('www.') -%}{%- set host = host[4:] -%}{%- endif -%}
  {%- if base.startswith('www.') -%}{%- set base = base[4:] -%}{%- endif -%}
  {%- if url.startswith('/') and not url.startswith('//') -%}{{- url.split('?')[0].split('#')[0] -}}
  {%- elif host and base and host == base -%}
    {{- '/' ~ url.split('://', 1)[1].partition('/')[2].split('?')[0].split('#')[0] -}}
  {%- endif -%}
{%- endmacro %}

{% macro platform(url) -%}
  {%- set host = link_host(url)|trim -%}
  {%- set result = namespace(name='link') -%}
  {%- for domain, name in {'zhihu.com':'zhihu', 'xiaohongshu.com':'xiaohongshu', 'xhslink.com':'xiaohongshu', 'x.com':'x', 'twitter.com':'x', 'bilibili.com':'bilibili', 'b23.tv':'bilibili', 'youtube.com':'youtube', 'youtu.be':'youtube', 't.me':'telegram', 'telegram.me':'telegram', 'telegram.org':'telegram', 'github.com':'github', 'weibo.com':'sinaweibo', 'weibo.cn':'sinaweibo', 'instagram.com':'instagram', 'xiaoyuzhoufm.com':'xiaoyuzhou', 'taiyin.podcast.xyz':'xiaoyuzhou'}.items() -%}
    {%- if host == domain or host.endswith('.' ~ domain) -%}{%- set result.name = name -%}{%- endif -%}
  {%- endfor -%}
  {%- if host == 'mp.weixin.qq.com' -%}{%- set result.name = 'wechat' -%}{%- endif -%}
  {{- result.name -}}
{%- endmacro %}


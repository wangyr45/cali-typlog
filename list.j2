}
.cali-native-share,.cali-native-foot,.subject-license {
  margin-top:32px;
  font-size:13px;
  color:var(--muted-foreground);
}
.cali-sr-only {
  position:absolute;
  width:1px;
  height:1px;
  padding:0;
  margin:-1px;
  overflow:hidden;
  clip:rect(0,0,0,0);
  white-space:nowrap;
  border:0;
}
.cali-skip {
  position:fixed;
  top:-100px;
  left:20px;
  z-index:80;
  padding:8px;
  background:var(--background);
}
.cali-skip:focus {
  top:10px;
}
@media(min-resolution:192dpi) {
  :root {

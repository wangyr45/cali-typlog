  margin:2.1em 0 .75em;
  font-weight:600;
}
.cali-prose h3 {
  font-size:18px;
  margin:1.7em 0 .6em;
}
.cali-prose a {
  text-decoration:underline;
  text-underline-offset:4px;
}
.cali-prose blockquote {

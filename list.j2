{% macro card(subject, heading='h2', month_day=false) %}
<article id="item-{{ subject.id }}">
<a class="blog-row hairline-top" href="{{ linkify(subject.url) }}">
<span class="print-pile" aria-hidden="true">
<span class="print-pile-sheet">
</span>
<span class="print-pile-sheet">
</span>
<span class="print-thumb"><span class="print-lines"></span>{% if subject.cover and subject.cover.src and subject.visibility|default('public') == 'public' %}<img data-cali-image data-cali-cover src="{{ subject.cover.src|thumbnail('s') }}" alt="" width="64" height="44" loading="lazy" decoding="async">{% endif %}</span>
</span>
<{{ heading }} class="blog-row-title">{{ subject.title }}{% if subject.visibility|default('public') != 'public' %}<span class="cali-sr-only"> · {{ labels.protected }}</span>{% endif %}</{{ heading }}>
<span class="blog-row-leader" aria-hidden="true">
</span>{% if subject.published_at %}<time class="blog-row-date" datetime="{{ subject.published_at|xmldatetime }}">{{ subject.published_at.strftime('%m/%d' if month_day else '%y/%m/%d') }}</time>{% endif %}</a>
</article>
{% endmacro %}


{% macro shelf(items, kind, number, title) %}
{% set entries = namespace(items=[]) %}
{% for item in items %}
  {% if item is mapping and item.title is string and item.title|trim %}
    {% set entries.items = entries.items + [item] %}
  {% endif %}
{% endfor %}
{% if entries.items %}
<section class="cali-section" id="{{ kind }}">
  {{ tag(number, title) }}
  <div class="cali-collection room-shelf {{ 'vinyl-room' if kind == 'records' else 'bookshelf-room' }}" data-collection="{{ kind }}">
    <div class="{{ 'vinyl-viewport' if kind == 'records' else 'bookshelf-viewport' }}" data-shelf-viewport hidden>
    {% if kind == 'books' %}<div class="bookshelf-track">{% endif %}
    <ul class="{{ 'vinyl-shelf' if kind == 'records' else 'shelf3' }}" aria-label="{{ title }}">
      {% for item in entries.items %}
      {% set tone = item.spine_color if item.spine_color is string else '' %}
      {% set ink = item.spine_ink if item.spine_ink is string else '' %}
      {% set hex = namespace(tone=true, ink=true) %}
      {% for c in tone|lower %}{% if c not in '#0123456789abcdef' %}{% set hex.tone = false %}{% endif %}{% endfor %}
      {% for c in ink|lower %}{% if c not in '#0123456789abcdef' %}{% set hex.ink = false %}{% endif %}{% endfor %}
      {% set ratio = item.width / item.height if item.width is number and item.height is number and item.width > 0 and item.height > 0 and item.width < 100000 and item.height < 100000 else 0.71 %}
      {% set cover_width = ([210, [100, ratio * 210]|max]|min)|round(2) %}
      {% set spine = ([38, [18, item.spine]|max]|min) if item.spine is number else 24 %}
      {% set cover = image_url(item.cover)|trim %}
      <li class="{{ 'vinyl' if kind == 'records' else 'book3-frame' }}" data-cover-width="{{ cover_width }}" data-spine="{{ spine }}" style="{% if tone|length == 7 and tone.startswith('#') and hex.tone %}--book-spine:{{ tone }};--vinyl-spine-color:{{ tone }};{% endif %}{% if ink|length == 7 and ink.startswith('#') and hex.ink %}--book-ink:{{ ink }};--vinyl-spine-ink:{{ ink }};{% endif %}">
      {% if kind == 'books' %}<span class="book3-contact-shadow" aria-hidden="true"></span>{% endif %}
      <button type="button" class="{{ 'vinyl-trigger' if kind == 'records' else 'book3' }}" data-shelf-select disabled aria-pressed="false" aria-label="{{ item.title }}" aria-posinset="{{ loop.index }}" aria-setsize="{{ entries.items|length }}">
      {% if kind == 'records' %}
        {% for corner in ['top-left','top-right','bottom-right','bottom-left'] %}<span class="vinyl-hit-corner" data-corner="{{ corner }}" aria-hidden="true"></span>{% endfor %}
        <span class="vinyl-contact-shadow" aria-hidden="true"></span>
        <span class="vinyl-object">
          <span class="vinyl-sleeve">
            <span class="vinyl-sleeve-type"><span class="vinyl-sleeve-album">{{ item.title }}</span>{% if item.author is string %}<span class="vinyl-sleeve-artist">{{ item.author }}</span>{% endif %}</span>
            {% if cover %}<img class="vinyl-art" data-cali-image src="{{ cover }}" alt="" loading="lazy" decoding="async" draggable="false">{% endif %}
            <span class="vinyl-creases" aria-hidden="true"></span><span class="vinyl-paper" aria-hidden="true"></span>
          </span>
          <span class="vinyl-spine vinyl-spine-left" aria-hidden="true"><span>{{ item.title }}</span></span>
          <span class="vinyl-spine vinyl-spine-right" aria-hidden="true"><span>{{ item.title }}</span></span>
        </span>
      {% else %}
        <span class="book3-inner" style="width:{{ cover_width }}px">
          <span class="book3-cover" style="transform:translateZ({{ spine }}px)">
            <span class="book3-cover-blank"><b>{{ item.title }}</b>{% if item.author is string %}{{ item.author }}{% endif %}</span>
            {% if cover %}<img data-cali-image src="{{ cover }}" alt="" loading="lazy" decoding="async" draggable="false">{% endif %}
          </span>
          <span class="book3-spine" style="width:{{ spine }}px"><span class="book3-spine-title">{{ item.spine_title if item.spine_title is string and item.spine_title else item.title }}</span>{% if item.author is string %}<span class="book3-spine-author">{{ item.author }}</span>{% endif %}</span>
        </span>
      {% endif %}
      </button>
      </li>
      {% endfor %}
    </ul>
    {% if kind == 'books' %}</div>{% endif %}
    </div>
    <span class="room-shelf-plank" data-shelf-plank hidden aria-hidden="true"></span>
    {% if kind == 'books' %}<p class="bookshelf-hint">{{ '左右滑动浏览' if zh else 'Scroll sideways to browse' }}</p>{% endif %}
    <div class="cali-shelf-captions" hidden aria-live="polite" aria-atomic="true">
      {% for item in entries.items %}
      <p{% if not loop.first %} hidden{% endif %}>
        {% set url = public_url(item.url)|trim %}
        {% if url %}<a href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ item.title }} ↗</a>
        {% else %}{{ item.title }}{% endif %}
        {% if item.author is string and item.author %}<span> · {{ item.author }}</span>{% endif %}
      </p>
      {% endfor %}
    </div>
    <ul class="cali-collection-list">
      {% for item in entries.items %}
      <li>
        {% set url = public_url(item.url)|trim %}
        {% if url %}<a href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ item.title }} ↗</a>
        {% else %}{{ item.title }}{% endif %}
        {% if item.author is string and item.author %}<span> · {{ item.author }}</span>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
{% endmacro %}

{% macro year_folio(year) %}
{% set digits = {'0':['01110','10001','10011','10101','11001','10001','01110'], '1':['00100','01100','00100','00100','00100','00100','01110'], '2':['01110','10001','00001','00010','00100','01000','11111'], '3':['11110','00001','00001','01110','00001','00001','11110'], '4':['00010','00110','01010','10010','11111','00010','00010'], '5':['11111','10000','10000','11110','00001','00001','11110'], '6':['01110','10000','10000','11110','10001','10001','01110'], '7':['11111','00001','00010','00100','01000','01000','01000'], '8':['01110','10001','10001','01110','10001','10001','01110'], '9':['01110','10001','10001','01111','00001','00001','01110']} %}
<svg class="ghost-folio" viewBox="0 0 12 7" aria-hidden="true" fill="currentColor">
{% for digit in year[2:] %}{% set x = loop.index0 * 7 %}{% for row in digits[digit] %}{% set y = loop.index0 %}{% for cell in row %}{% if cell == '1' %}<rect x="{{ x + loop.index0 }}" y="{{ y }}" width="1" height="1"/>{% endif %}{% endfor %}{% endfor %}{% endfor %}
</svg>
{% endmacro %}

{% macro writing_list(subjects) %}
{% set group = namespace(year=none, started=false) %}
<div class="cali-writing-groups">
{% for subject in subjects %}
  {% set year = subject.published_at.strftime('%Y') if subject.published_at else '' %}
  {% if not group.started or group.year != year %}
    {% if group.started %}</div></section>{% endif %}
    {% set group.year = year %}{% set group.started = true %}
    <section class="cali-writing-year"{% if year %} aria-labelledby="writing-year-{{ year }}"{% endif %}>
    {% if year %}{{ year_folio(year) }}<h2 id="writing-year-{{ year }}" class="cali-year-heading">{{ year }}</h2>{% endif %}
    <div class="cali-list-grid">
  {% endif %}
  {{ card(subject, 'h3', true) }}
{% else %}<p class="cali-empty">{{ labels.empty }}</p>{% endfor %}
{% if group.started %}</div></section>{% endif %}
</div>
{% endmacro %}

{% block style %}<style>
/* Adapted from Cali Castle, upstream/dev a35dcf2. See LICENSE. */
.section-tag {
  display: inline-flex;
  align-items: stretch;
  gap: 0;
  color: var(--gray-8, var(--muted-foreground));
  font-family: var(--font-geist-mono), var(--font-frex-gb, ui-monospace), ui-monospace, monospace;
  font-size: 0.75rem;
  font-weight: var(--font-weight-normal);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.section-tag-index {
  display: flex;
  align-items: center;
  padding: 0.0625rem 0.375rem;
  border: var(--border-hairline) solid color-mix(in oklab, var(--muted-foreground) 45%, transparent);
  font-size: 0.6875rem;
  font-variant-numeric: tabular-nums;
}

/* hazard hatch: fine diagonal strokes in a bordered chip */
.section-tag-hatch {
  width: 0.75rem;
  border: var(--border-hairline) solid color-mix(in oklab, var(--muted-foreground) 45%, transparent);
  border-left: none;
  background: repeating-linear-gradient(
    -45deg,
    color-mix(in oklab, var(--muted-foreground) 55%, transparent) 0,
    color-mix(in oklab, var(--muted-foreground) 55%, transparent) 1px,
    transparent 1px,
    transparent 3.5px
  );
}

.section-tag-label {
  align-self: center;
  padding-left: 0.625rem;
}


.blog-row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.5rem 0;
  font-size: 0.9375rem;
}

/* the date is quiet metadata — one step down from the row's title */
.blog-row-date {
  font-size: 0.8125rem;
  letter-spacing: 0.01em;
}

.print-pile {
  position: relative;
  isolation: isolate;
  display: block;
  width: 4rem;
  height: 2.75rem;
  flex: none;
  pointer-events: none;
  user-select: none;
}

.print-pile-sheet {
  position: absolute;
  inset: 1px;
  border-radius: 3px;
  background: var(--paper);
  box-shadow: 0 0 0 1px color-mix(in oklab, var(--paper-ink) 22%, transparent);
}

.print-pile-sheet:first-child {
  opacity: 0.62;
  transform: translate(-2px, 1px) rotate(-1.6deg);
}

.print-pile-sheet:nth-child(2) {
  opacity: 0.82;
  transform: translate(2px, -1px) rotate(1.1deg);
}

.print-thumb {
  position: relative;
  display: block;
  width: 4rem;
  height: 2.75rem;
  flex-shrink: 0;
  border-radius: 3px;
  overflow: hidden;
  box-shadow: 0 0 0 1px var(--border);
}

.print-thumb-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.print-thumb-empty {
  background: var(--muted);
}

.blog-row-title {
  min-width: 0;
  color: var(--gray-11, var(--foreground));
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

@media (max-width: 39.99rem) {
  .blog-row-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    white-space: normal;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
}

/* dotted leader between title and date — the typewriter TOC register */
.blog-row-leader {
  flex: 1;
  min-width: 1.5rem;
  height: 1px;
  align-self: center;
  background: radial-gradient(
      circle,
      color-mix(in oklab, var(--muted-foreground) 41%, transparent) 0.5px,
      transparent 0.5px
    )
    0 0 / 6px 1px repeat-x;
}


.polaroid {
  background: var(--paper);
  padding: 2% 2% 0;
  box-shadow:
    0 0 0 1px rgb(0 0 0 / 0.04),
    0 2px 4px -1px rgb(0 0 0 / 0.18);
}

/* hairline ring where photo meets frame — sells the print edge */
.polaroid-photo {
  position: relative;
  display: block;
}

.polaroid-photo::after {
  content: '';
  position: absolute;
  inset: 0;
  box-shadow: inset 0 0 2px rgb(0 0 0 / 0.14);
  pointer-events: none;
}

.polaroid-caption {
  display: flex;
  align-items: center;
  min-height: 1.75rem;
  padding: 0.2rem 0.125rem;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  color: var(--paper-ink);
  user-select: none;
}

.polaroid-tilted {
  transform: rotate(var(--tilt, 0deg));
}


.dock {
  position: fixed;
  bottom: 1.25rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: var(--z-nav);
  display: flex;
  align-items: center;
  gap: 0.25rem;
  height: 3.5rem;
  padding: 0.375rem;
  border-radius: 999px;
  background: color-mix(in oklab, var(--background) 68%, transparent);
  box-shadow: 0 0 0 1px var(--border), var(--shadow-medium);
}

@media (max-width: 39.99rem) {
  .dock {
    bottom: max(0.5rem, env(safe-area-inset-bottom, 0px));
  }
}

/* the frosted pane — its backdrop-filter is set inline from the
   component (LightningCSS strips the property from stylesheets) */
.dock-glass {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  /* specular rim: light catching the top edge of the glass */
  box-shadow:
    inset 0 1px 0 rgb(255 255 255 / 0.2),
    inset 0 -1px 0 rgb(255 255 255 / 0.06);
}

.dock-item {
  position: relative;
  display: grid;
  place-items: center;
  width: 2.75rem;
  height: 2.75rem;
  border-radius: 999px;
  color: var(--muted-foreground);
  transition: color 150ms ease, background-color 150ms ease;
}

@media (hover: hover) and (pointer: fine) {
  .dock-item:hover {
    color: var(--foreground);
    background: color-mix(in oklab, var(--foreground) 6%, transparent);
  }
}

.dock-item:active {
  transform: scale(0.97);
}

.dock-item[data-active] {
  color: var(--foreground);
}

.dock-active-indicator {
  --dock-indicator-x: 0px;

  position: absolute;
  z-index: 1;
  bottom: 8px;
  left: 0;
  width: 4px;
  height: 4px;
  border-radius: 999px;
  background: var(--foreground);
  opacity: 0;
  pointer-events: none;
  transform: translate3d(calc(var(--dock-indicator-x) - 50%), 0, 0);
  transition:
    transform 220ms var(--ease-swift),
    opacity 120ms ease;
  will-change: transform;
}

.dock-active-indicator[data-ready] {
  opacity: 1;
}

.dock-active-indicator[data-instant] {
  transition: none;
}

.dock-avatar {
  display: block;
  width: 1.625rem;
  height: 1.625rem;
  border-radius: 999px;
  overflow: hidden;
  box-shadow: inset 0 0 0 1px var(--border);
}

.dock-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.dock-rule {
  /* positioned so it paints above the glass layer — static children fall
     in the earlier paint phase and get refracted like the backdrop */
  position: relative;
  width: 1px;
  height: 1.125rem;
  margin: 0 0.125rem;
  background: color-mix(in oklab, var(--foreground) 16%, transparent);
}


.nav-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 3.5rem;
  /* bleed to the column's outer edges (through the px-6 padding), not
     the viewport */
  margin-left: -1.5rem;
  margin-right: -1.5rem;
  border-top: var(--border-hairline) solid var(--border);
  border-bottom: var(--border-hairline) solid var(--border);
}

.nav-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
  padding: 1.5rem 0.75rem 1.25rem;
}

.nav-card + .nav-card {
  border-left: var(--border-hairline) solid var(--border);
}

.nav-card:active {
  transform: scale(0.985);
}

.nc-vignette {
  position: relative;
  display: grid;
  place-items: center;
  height: 3.5rem;
  width: 100%;
  margin-bottom: 0.375rem;
}

/* manuscript pages: three ruled sheets, loosely stacked */
.nc-sheets span {
  position: absolute;
  width: 2.375rem;
  height: 2.875rem;
  transition: transform 300ms var(--ease-spring);
  background:
    repeating-linear-gradient(
      to bottom,
      transparent 0 7px,
      color-mix(in oklab, var(--paper-ink) 35%, transparent) 7px 7.5px
    )
    50% 60% / 70% 60% no-repeat,
    var(--paper);
  box-shadow: 0 0 0 1px rgb(0 0 0 / 0.08), 0 1px 2px rgb(0 0 0 / 0.12);
}

.nc-sheets span:nth-child(1) {
  transform: rotate(-7deg) translateX(-9px);
}

.nc-sheets span:nth-child(2) {
  transform: rotate(4deg) translateX(9px);
}

.nc-sheets span:nth-child(3) {
  transform: rotate(-1deg) translateY(-2px);
}

@media (hover: hover) and (pointer: fine) {
  .nav-card:hover .nc-sheets span:nth-child(1) {
    transform: rotate(-13deg) translateX(-16px) translateY(-2px);
  }

  .nav-card:hover .nc-sheets span:nth-child(2) {
    transform: rotate(9deg) translateX(16px) translateY(-1px);
  }

  .nav-card:hover .nc-sheets span:nth-child(3) {
    transform: rotate(-2deg) translateY(-5px);
  }
}

/* fanned polaroid minis */
.nc-polaroid {
  position: absolute;
  padding: 3px 3px 8px;
  background: var(--paper);
  box-shadow: 0 0 0 1px rgb(0 0 0 / 0.08), 0 1px 3px rgb(0 0 0 / 0.15);
  transform: rotate(calc(var(--i) * 9deg - 9deg)) translateX(calc(var(--i) * 16px - 16px));
  transition: transform 300ms var(--ease-spring);
}

@media (hover: hover) and (pointer: fine) {
  .nav-card:hover .nc-polaroid {
    transform: rotate(calc(var(--i) * 15deg - 15deg)) translateX(calc(var(--i) * 24px - 24px))
      translateY(calc((1 - var(--i)) * (1 - var(--i)) * 2px - 3px));
  }
}

.nc-polaroid img {
  display: block;
  width: 2.25rem;
  height: 1.875rem;
  object-fit: cover;
}

.nc-polaroid-placeholder::before {
  display: block;
  width: 2.25rem;
  height: 1.875rem;
  background: color-mix(in oklab, var(--foreground) 8%, var(--paper));
  content: '';
}

/* standalone construction icon + the crossed project mark */
.nc-project-icon {
  position: absolute;
  isolation: isolate;
  width: 3.25rem;
  height: 3.25rem;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  overflow: hidden;
  border: var(--border-hairline) solid color-mix(in oklab, var(--foreground) 20%, var(--border));
  border-radius: 0.75rem;
  background: color-mix(in oklab, var(--foreground) 4%, var(--background));
  box-shadow: var(--shadow-3);
  transition: transform 300ms var(--ease-spring);
}

@media (max-width: 39.99rem) {
  .nav-card {
    min-width: 0;
    gap: 0.125rem;
    padding: 1.25rem 0.375rem 1rem;
  }

  .nc-vignette {
    min-width: 0;
    max-width: 100%;
    height: 3.25rem;
    margin-bottom: 0.25rem;
  }
}

.nc-construction-guides {
  position: absolute;
  z-index: 1;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
  pointer-events: none;
}

.nc-guide-solid {
  stroke: color-mix(in oklab, var(--foreground) 25%, transparent);
  stroke-width: 0.65;
  vector-effect: non-scaling-stroke;
}

.nc-project-mark {
  position: absolute;
  z-index: 2;
  top: 50%;
  left: 50%;
  width: 30px;
  height: 30px;
  color: color-mix(in oklab, var(--foreground) 84%, var(--muted-foreground));
  overflow: visible;
  transform: translate(-50%, -50%);
}

.nc-explode-a,
.nc-explode-b,
.nc-explode-c {
  transform-box: fill-box;
  transform-origin: center;
  transition: transform 300ms var(--ease-spring);
}

@media (hover: hover) and (pointer: fine) {
  .nav-card:hover .nc-project-icon {
    transform: translate(-50%, calc(-50% - 2px));
  }

  .nav-card:hover .nc-explode-a {
    transform: translate(1.5px, -1.5px) rotate(3deg);
  }

  .nav-card:hover .nc-explode-b {
    transform: translate(-2.5px, -2px) rotate(-6deg);
  }

  .nav-card:hover .nc-explode-c {
    transform: translate(2px, 2.5px) rotate(5deg);
  }
}

.nc-label {
  font-size: 0.875rem;
  font-weight: var(--font-weight-medium);
  color: var(--foreground);
}

.nc-sub {
  font-size: 0.875rem;
  color: var(--muted-foreground);
  font-variant-numeric: tabular-nums;
}

@media (max-width: 39.99rem) {
  .nc-label {
    font-size: 0.8125rem;
    line-height: 1.25;
  }

  .nc-sub {
    font-size: 0.75rem;
    line-height: 1.25;
    white-space: nowrap;
  }
}

@media (prefers-reduced-motion: reduce) {
  .nc-sheets span,
  .nc-polaroid,
  .nc-project-icon,
  .nc-explode-a,
  .nc-explode-b,
  .nc-explode-c {
    transition: none;
  }

  .nav-card:hover .nc-project-icon {
    transform: translate(-50%, -50%);
  }
}

:root {
  --border-hairline:1px;
  --gray-1:oklch(.99 .001 95);
  --gray-2:oklch(.975 .0015 95);
  --gray-3:oklch(.95 .002 95);
  --gray-4:oklch(.91 .0025 92);
  --gray-8:oklch(.56 .004 78);
  --gray-10:oklch(.39 .0045 74);
  --gray-11:oklch(.31 .0045 72);
  --gray-12:oklch(.23 .0045 70);
  --paper:oklch(.98 .004 95);
  --paper-ink:oklch(.52 .012 95);
  --signal:oklch(.62 .17 45);
  --background:var(--gray-1);
  --foreground:var(--gray-12);
  --muted:var(--gray-3);
  --muted-foreground:var(--gray-8);
  --border:var(--gray-4);
  --font-geist-mono:ui-monospace;
  --font-weight-normal:400;
  --font-weight-medium:500;
  --shadow-medium:0 8px 30px #00000010,0 2px 5px #00000008;
  --shadow-3:0 2px 4px #0000000a;
  --ease-spring:cubic-bezier(.22,1,.36,1);
  --ease-swift:cubic-bezier(.2,.8,.2,1);
  --z-nav:40;
}
.dark-theme {
  color-scheme:dark;
  --gray-1:oklch(.16 .006 80);
  --gray-2:oklch(.19 .007 80);
  --gray-3:oklch(.22 .008 80);
  --gray-4:oklch(.27 .009 80);
  --gray-8:oklch(.61 .01 84);
  --gray-10:oklch(.78 .008 88);
  --gray-11:oklch(.87 .007 90);
  --gray-12:oklch(.94 .006 92);
  --signal:oklch(.7 .17 48);
  --paper:oklch(.26 .006 80);
  --paper-ink:oklch(.7 .012 95);
}
*,*::before,*::after {
  box-sizing:border-box;
}
html {
  font-size:16px;
  scroll-padding-top:24px;
}
body {
  margin:0;
  background:var(--background);
  color:var(--foreground);
  font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  -webkit-font-smoothing:antialiased;
  font-size:14px;
  line-height:1.72;
}
.cali-shell a {
  color:inherit;
  text-decoration:none;
}
.cali-shell a:hover {
  color:var(--foreground);
}
.cali-shell button,.cali-shell input {
  font:inherit;
}
.cali-shell button {
  cursor:pointer;
}
.dock-item>svg {
  display:block;
  width:22px;
  height:22px;
}
.cali-shell img {
  max-width:100%;
  height:auto;
}
.cali-shell h1,.cali-shell h2,.cali-shell p {
  margin:0;
}
.cali-shell :focus-visible {
  outline:2px solid var(--signal);
  outline-offset:4px;
}
.cali-shell [hidden] {
  display:none!important;
}
.cali-shell {
  max-width:600px;
  margin:0 auto;
  padding:56px 24px 0;
  min-height:100vh;
  border-left:1px dashed var(--border);
  border-right:1px dashed var(--border);
}
.cali-hero {
  display:grid;
  grid-template-columns:minmax(0,1fr) 240px;
  gap:32px;
}
.cali-introduction h1 {
  font-size:28px;
  line-height:1.25;
  letter-spacing:-.035em;
  font-weight:600;
  display:flex;
  gap:9px;
  align-items:center;
}
.cali-introduction p {
  margin-top:18px;
  font-size:14px;
  line-height:1.72;
  color:var(--gray-11);
}
.cali-pixel-mark {
  font-size:10px;
  line-height:7px;
  letter-spacing:-1px;
  color:var(--signal);
}
.cali-portrait {
  border-radius:0;
  position:relative;
  width:240px;
  height:240px;
  align-self:start;
  overflow:hidden;
}
.cali-portrait img {
  display:block;
  width:100%;
  height:100%;
  object-fit:cover;
}
.cali-portrait-monogram {
  display:grid;
  place-items:center;
  width:100%;
  height:100%;
  font-size:120px;
  line-height:1;
  background:var(--gray-2);
  color:var(--muted-foreground);
  font-family:serif;
}
.nc-project-mark svg {
  width:30px;
  height:30px;
}
.nav-cards {
  margin-top:56px;
}
.cali-section {
  margin-top:40px;
}
.cali-section-heading {
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:18px;
  gap:16px;
}
.cali-section-heading>a {
  font-size:12px;
  color:var(--muted-foreground);
}
.cali-section>.section-tag {
  margin-bottom:18px;
}
.hairline-top {
  border-top:var(--border-hairline) solid var(--border);
}
.cali-list-grid article:first-child .hairline-top {
  border-top:0;
}
.blog-row-title {
  font-weight:500;
  font-size:15px;
  line-height:1.6;
}
.blog-row-date {
  color:var(--muted-foreground);
  font-family:ui-monospace,monospace;
  white-space:nowrap;
}
.blog-row-leader {
  flex:1;
  min-width:24px;
  height:1px;
  background:repeating-linear-gradient(to right,var(--border) 0 2px,transparent 2px 6px);
}
.print-thumb {
  display:grid;
  place-items:center;
  overflow:hidden;
  background:var(--paper);
}
.print-thumb img {
  width:100%;
  height:100%;
  object-fit:cover;
}
.print-lines {
  width:65%;
  height:55%;
  background:repeating-linear-gradient(to bottom,transparent 0 5px,var(--border) 5px 6px);
}
.dock-glass {
  backdrop-filter:blur(20px) saturate(1.4);
  -webkit-backdrop-filter:blur(20px) saturate(1.4);
}
.dock {
  width:max-content;
  max-width:calc(100vw - 24px);
}
.dock-rule,.cali-preferences {
  flex-shrink:0;
}
.dock-secondary {
  display:flex;
  align-items:center;
  gap:4px;
  min-width:0;
  max-width:240px;
  height:52px;
  overflow-x:auto;
  overscroll-behavior-x:contain;
  scrollbar-width:thin;
  scrollbar-color:var(--border) transparent;
  z-index:1;
}
.dock-secondary .dock-item {
  position:static;
}
.dock-secondary .dock-item:focus-visible {
  outline-offset:-3px;
}
.dock-secondary .dock-item[aria-current] {
  background:var(--muted);
}
.dock-secondary .dock-item[aria-current]::after {
  content:none;
}
.dock-secondary .dock-item:active {
  transform:none;
}
.dock-item {
  border:0;
  background:none;
  flex:none;
  cursor:pointer;
}
.dock-label {
  position:absolute;
  bottom:calc(100% + 14px);
  left:50%;
  transform:translateX(-50%);
  padding:3px 9px;
  border-radius:6px;
  width:max-content;
  max-width:min(280px, calc(100vw - 40px));
  white-space:normal;
  overflow-wrap:anywhere;
  text-align:center;
  font-size:12px;
  background:var(--foreground);
  color:var(--background);
  opacity:0;
  pointer-events:none;
  transition:opacity .15s;
}
.dock-item:hover>.dock-label,.dock-item:focus-visible>.dock-label {
  opacity:1;
}
.dock-item[aria-current]::after {
  position:absolute;
  bottom:1px;
  width:3px;
  height:3px;
  border-radius:50%;
  background:currentColor;
  content:"";
}
.dock-avatar {
  display:grid;
  place-items:center;
  font-size:13px;
  background:var(--gray-3);
}
.cali-preferences summary {
  list-style:none;
}
.cali-preferences summary::-webkit-details-marker {
  display:none;
}
.cali-preferences-panel {
  position:absolute;
  bottom:64px;
  right:-6px;
  width:280px;
  padding:16px;
  background:var(--background);
  border:1px solid var(--border);
  border-radius:14px;
  box-shadow:var(--shadow-medium);
  max-height:65vh;
  overflow:auto;
}
.cali-preferences-panel>p {
  font-size:12px;
  color:var(--muted-foreground);
  margin-bottom:12px;
}
.cali-preferences-panel nav {
  display:flex;
  flex-direction:column;
  gap:6px;
  margin-top:14px;
  border-top:1px solid var(--border);
  padding-top:10px;
}
.cali-theme-control {
  display:flex;
  justify-content:space-between;
  align-items:center;
  min-height:40px;
  cursor:pointer;
}
.cali-theme-control input {
  accent-color:var(--foreground);
  width:18px;
  height:18px;
}
.cali-search {
  display:block;
  width:100%;
  border:1px solid var(--border);
  border-radius:6px;
  padding:9px;
  background:var(--gray-2);
  color:var(--foreground);
  margin:10px 0;
}
.cali-button {
  width:100%;
  padding:8px;
  border:1px solid var(--border);
  border-radius:6px;
  color:var(--foreground);
  background:var(--gray-2);
}
.cali-footer {
  display:grid;
  grid-template-columns:1fr 1fr;
  margin-top:56px;
  padding:32px 0 110px;
  border-top:1px solid var(--border);
  font-size:12px;
}
.cali-footer h2 {
  font-size:12px;
  color:var(--muted-foreground);
  font-weight:400;
  letter-spacing:.08em;
  margin-bottom:12px;
}
.cali-footer nav {
  display:flex;
  flex-direction:column;
  align-items:start;
  gap:5px;
}
.cali-footer .cali-social svg {
  width:16px;
  height:16px;
}
.cali-colophon {
  grid-column:1/-1;
  display:flex;
  justify-content:space-between;
  color:var(--muted-foreground);
  padding-top:32px;
}
.cali-page-heading {
  padding-bottom:30px;
}
.cali-page-heading h1 {
  font-size:24px;
  font-weight:600;
  letter-spacing:-.025em;
}
.cali-page-heading p {
  margin-top:12px;
  color:var(--muted-foreground);
}
.cali-pagination,.cali-years {
  display:flex;
  flex-wrap:wrap;
  gap:24px;
  margin-top:30px;
  font-size:13px;
}
.cali-years a[aria-current] {
  text-decoration:underline;
}
.cali-pagination {
  justify-content:space-between;
}
.cali-empty {
  color:var(--muted-foreground);
  padding:24px 0;
}
.cali-back {
  font-size:12px;
  color:var(--muted-foreground)!important;
  display:inline-block;
  margin-bottom:32px;
}
.cali-article-heading h1 {
  font-size:24px;
  line-height:1.4;
  font-weight:600;
  letter-spacing:-.025em;
  margin:24px 0 12px;
}
.cali-article-heading .p-summary {
  color:var(--muted-foreground);
  margin-bottom:20px;
}
.cali-article-cover {
  display:block;
  width:100%;
  max-height:360px;
  object-fit:cover;
  padding:9px 9px 30px;
  background:var(--paper);
  border:1px solid var(--border);
  box-shadow:0 2px 5px #0000000a;
  transform:rotate(-1deg);
  margin:12px 0 32px;
}
.cali-meta {
  display:flex;
  gap:16px;
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
  padding:10px 0;

      item.addEventListener("pointerenter", (event) => { if (event.pointerType !== "touch") show(item); });
      item.addEventListener("pointerleave", () => { if (document.activeElement !== item) hide(); });
      item.addEventListener("focus", () => show(item));
      item.addEventListener("blur", hide);
      item.addEventListener("click", hide);
      item.removeAttribute("title");
    });
    dock.dataset.tipsReady = "true";
    window.addEventListener("resize", hide);
    window.addEventListener("scroll", hide, {capture: true, passive: true});
    document.addEventListener("keydown", (event) => { if (event.key === "Escape") hide(); });
  }

  const dialog = document.querySelector(".cali-qr-dialog");
  if (!dialog || typeof dialog.showModal !== "function") return;
  const image = dialog.querySelector("[data-qr-full]");
  const title = dialog.querySelector("h2");
  const original = dialog.querySelector("[data-qr-original]");
  let opener;
  document.querySelectorAll("[data-cali-qr]").forEach((link) => {
    link.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      image.src = link.href;
      image.alt = link.dataset.qrTitle;
      title.textContent = link.dataset.qrTitle;
      original.href = link.href;

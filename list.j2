/* Editorial identity and a quiet spectrum for the opening line. */
.cali-motto { line-height:1.8; }
.cali-motto span { color:#726582; }
@supports ((background-clip:text) or (-webkit-background-clip:text)) {
  .cali-motto span {
    background:linear-gradient(110deg,#a75564 0%,#946747 21%,#75763d 40%,#417b70 59%,#526e9b 78%,#8b6592 100%);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    -webkit-box-decoration-break:clone;
    box-decoration-break:clone;
  }
  .dark-theme .cali-motto span {
    background-image:linear-gradient(110deg,#df9daa 0%,#d8b28f 21%,#bdc38d 40%,#93c5b8 59%,#9db9dc 78%,#c6a5d2 100%);
  }
}
.cali-subscribe-link {
  display:inline; padding:2px 0; border:0; border-bottom:1px solid var(--border);
  border-radius:0; background:transparent; color:var(--foreground);
  text-decoration:none; text-underline-offset:4px;
}
.cali-subscribe-link span { font-size:.9em; margin-left:2px; }
.cali-subscribe-link:active { opacity:.65; }
.cali-colophon { align-items:baseline; flex-wrap:wrap; gap:10px 16px; }
.cali-colophon-links { display:flex; align-items:baseline; flex-wrap:wrap; gap:6px 18px; }
.cali-colophon-links>span { white-space:nowrap; }
.cali-credit a { text-decoration:none; }
.cali-portrait img {
  filter:grayscale(1) contrast(1.08);
  -webkit-mask-image:linear-gradient(to right,transparent,#000 10%,#000 90%,transparent),linear-gradient(to bottom,#000 86%,transparent);
  mask-image:linear-gradient(to right,transparent,#000 10%,#000 90%,transparent),linear-gradient(to bottom,#000 86%,transparent);
  -webkit-mask-composite:source-in;
  mask-composite:intersect;
}
.cali-portrait canvas { position:absolute; inset:0; width:100%; height:100%; display:block; }
.cali-portrait-monogram { border-radius:0; background:transparent; }
@media(hover:hover) and (pointer:fine) {
  .cali-subscribe-link:hover { border-color:var(--foreground); }
  .cali-credit a:hover { text-decoration:underline; }
}

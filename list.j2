.project-external { font-size:12px; color:var(--muted-foreground); }
.project-icon-frame>img { position:absolute; top:4px; left:4px; }
.project-monogram { display:grid; place-items:center; background:var(--gray-3); color:var(--foreground); font:500 21px/1 ui-serif,serif; }
.cali-projects-back { margin-top:28px!important; font-size:12px; color:var(--muted-foreground); }
.cali-projects-back a { display:inline-block; padding-block:10px; }
@media(max-width:639px) {
  .cali-projects-view { padding-inline:8px; }
  .project-row { column-gap:14px; }
}

.cali-skip-projects { display:none; }
.cali-shell:has(#projects:target) .cali-skip-main { display:none; }
.cali-shell:has(#projects:target) .cali-skip-projects { display:block; }

/* Content landmarks accept focus without drawing a frame around the page. */
.cali-shell #projects:focus,
.cali-shell #projects:focus-visible,
.cali-shell #cali-main:focus,
.cali-shell #cali-main:focus-visible { outline:none; }
.dock-secondary .dock-item { position:relative; }
.dock[data-tips-ready] .dock-label { display:none; }
.cali-floating-tip {
  position:fixed; z-index:100; width:max-content;
  max-width:min(280px,calc(100vw - 20px)); padding:5px 10px;
  border-radius:6px; background:var(--foreground); color:var(--background);
  font:12px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  text-align:center; overflow-wrap:anywhere; pointer-events:none;
  box-shadow:0 2px 8px #00000010;
}
.cali-floating-tip[hidden] { display:none; }
.cali-footer { grid-template-columns:minmax(110px,.85fr) minmax(0,1.65fr); gap:28px; }
.cali-footer .cali-social { gap:0; align-items:stretch; padding-left:12px; }
.cali-social a {
  position:relative; display:flex; align-items:center; gap:7px; min-height:36px;
  width:fit-content; max-width:100%; padding:5px 0 5px 12px;
  font-size:12px; color:var(--muted-foreground); line-height:1.5;
}
.cali-social a::before { content:""; position:absolute; left:0; top:0; bottom:0; width:8px; border-left:1px solid var(--border); }
.cali-social a:last-child::before { bottom:50%; }
.cali-social a::after { content:""; position:absolute; width:8px; left:0; top:50%; border-top:1px solid var(--border); }
.cali-social a>svg,.cali-social a>.icon { flex:none; width:14px; height:14px; }
.contact-label { overflow-wrap:anywhere; }
.contact-arrow { flex:none; opacity:.45; transition:transform 150ms ease,opacity 150ms ease; }
.cali-qr-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
.cali-qr-card { display:flex; flex-direction:column; gap:7px; min-width:0; font-size:12px; }
.cali-qr-thumb { display:block; width:100%; max-width:140px; aspect-ratio:1; padding:5px; border:1px solid var(--border); border-radius:10px; background:#fff; transition:transform 180ms ease,border-color 180ms ease; }
.cali-qr-thumb img { display:block; width:100%; height:100%; object-fit:contain; border-radius:5px; }
.cali-qr-title { line-height:1.5; color:var(--foreground); }
.cali-qr-title>span { color:var(--muted-foreground); font-size:11px; }
.cali-colophon { padding-top:4px; }
.cali-qr-dialog {
  width:min(390px,calc(100vw - 32px)); max-height:calc(100dvh - 32px);
  margin:auto; padding:20px; border:1px solid var(--border); border-radius:16px;
  background:var(--background); color:var(--foreground); box-shadow:var(--shadow-medium);
  font:14px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}
.cali-qr-dialog::backdrop { background:#0008; backdrop-filter:blur(5px); }
.cali-qr-dialog-heading { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:16px; }
.cali-qr-dialog-heading h2 { font-size:15px; font-weight:500; margin:0; }
.cali-qr-dialog-heading button { width:36px; height:36px; border:1px solid var(--border); background:var(--gray-2); color:var(--foreground); border-radius:50%; font-size:22px; cursor:pointer; }
.cali-qr-dialog>img { display:block; width:100%; height:auto; max-height:55dvh; object-fit:contain; background:#fff; border-radius:9px; }
.cali-qr-dialog>p { margin:16px 0 8px; color:var(--muted-foreground); font-size:12px; }
.cali-qr-dialog>a { display:inline-block; padding-block:6px; font-size:12px; }
@media(hover:hover) and (pointer:fine) {
  .cali-social a:hover .contact-arrow { opacity:1; transform:translate(1px,-1px); }
  .cali-qr-card:hover .cali-qr-title { color:var(--foreground); }
}
@media(max-width:639px) {
  .cali-footer { grid-template-columns:1fr; gap:28px; padding-inline:8px; }
  .cali-qr-grid { max-width:330px; gap:24px; }
  .cali-qr-thumb { max-width:144px; }

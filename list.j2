/* Projects keep the compact list proportions of cali.so. */
.project-row {
  display: grid;
  grid-template-columns: 2.75rem minmax(0, 9rem) minmax(0, 1fr);
  align-items: start;
  gap: 0.25rem 1rem;
  min-height: 4.75rem;
  padding-block: 0.875rem;
  font-size: 0.875rem;
}

.page-introduction {
  color: var(--gray-10, var(--foreground));
  font-size: 0.875rem;
  line-height: 1.7;
}

.project-row:focus-visible {
  border-radius: 2px;
  outline: 1px solid var(--focus-ring, var(--signal));
  outline-offset: 3px;
}

.project-icon-frame {
  position: relative;
  display: grid;
  width: 2.75rem;
  height: 2.75rem;
  place-items: center;
  isolation: isolate;
}

.project-icon-frame::before {
  position: absolute;
  inset: 0;
  color: var(--foreground);
  background:
    linear-gradient(currentColor, currentColor) left top / 7px var(--border-hairline) no-repeat,
    linear-gradient(currentColor, currentColor) left top / var(--border-hairline) 7px no-repeat,
    linear-gradient(currentColor, currentColor) right top / 7px var(--border-hairline) no-repeat,
    linear-gradient(currentColor, currentColor) right top / var(--border-hairline) 7px no-repeat,
    linear-gradient(currentColor, currentColor) left bottom / 7px var(--border-hairline) no-repeat,
    linear-gradient(currentColor, currentColor) left bottom / var(--border-hairline) 7px no-repeat,
    linear-gradient(currentColor, currentColor) right bottom / 7px var(--border-hairline) no-repeat,
    linear-gradient(currentColor, currentColor) right bottom / var(--border-hairline) 7px no-repeat;
  content: '';
  opacity: 0;
  transform: scale(0.82);
  transition:
    opacity 150ms ease,
    transform 300ms var(--ease-spring);
}

.project-icon {
  position: relative;
  z-index: 1;
  width: 2.25rem;
  height: 2.25rem;
  border-radius: 0.5rem;
  object-fit: cover;
  box-shadow: 0 0 0 var(--border-hairline) color-mix(in oklab, var(--foreground) 10%, transparent);
  transition: transform 300ms var(--ease-spring);
}

.project-identity {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.125rem;
  line-height: 1.4;
}

.project-name {
  max-width: 100%;
  color: var(--gray-11, var(--foreground));
  text-wrap: balance;
}

.project-domain {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: color 150ms ease;
}

.project-description {
  min-width: 0;
  color: var(--gray-8, var(--muted-foreground));
  line-height: 1.55;
  text-wrap: balance;
}

@media (hover: hover) and (pointer: fine) {
  .project-row:hover .project-icon-frame::before {
    opacity: 0.34;
    transform: scale(1);
  }

  .project-row:hover .project-icon {
    transform: translateY(-1px);
  }

  .project-row:hover .project-domain {
    color: var(--foreground);
  }
}

.project-row:focus-visible .external-label .external-mark {
  opacity: 0.6;
  transition: none;
}

@media (max-width: 39.99rem) {
  .project-row {
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: start;
    row-gap: 0.375rem;
    min-height: 0;
    padding-block: 1rem;
  }

  .project-icon-frame {
    grid-row: 1 / span 2;
  }

  .project-identity,
  .project-description {
    grid-column: 2;
  }

  .project-domain {
    overflow: visible;
    text-overflow: clip;
    white-space: normal;
    overflow-wrap: anywhere;
  }
}

@media (prefers-reduced-motion: reduce) {
  .project-icon-frame::before,
  .project-icon,
  .project-domain {
    transition: none;
  }

  .project-row:hover .project-icon {
    transform: none;
  }

  .project-row:hover .project-icon-frame::before {
    transform: none;
  }
}


.cali-projects-view { display:none; scroll-margin-top:48px; }
.cali-projects-view:target { display:block; }
.cali-projects-view:target ~ .cali-home-view { display:none; }
.cali-projects-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:24px; }
.cali-projects-heading h1 { font:400 12px/1.5 ui-monospace,monospace; letter-spacing:.08em; color:var(--muted-foreground); }
.cali-projects-heading h1::before { content:'// '; opacity:.6; }
.cali-projects-heading p { max-width:440px; margin-top:16px; color:var(--gray-11); font-size:14px; line-height:1.7; text-wrap:balance; }
.cali-projects-heading .cali-pixel-mark { margin-top:4px; }
.cali-project-list { list-style:none; padding:0; margin:40px 0 0; border-bottom:var(--border-hairline) solid var(--border); }
.project-name { font-weight:500; }

    keyboard = sessionStorage.getItem(storageKey) === "1";
    sessionStorage.removeItem(storageKey);
  } catch { /* Navigation must also work with storage disabled. */ }

  function stop() {
    if (frame) window.cancelAnimationFrame(frame);
    frame = 0;
    animations.forEach(animation => animation.cancel());
    animations = [];
  }
  function enter() {
    stop();
    if (keyboard || reduced.matches) return;
    const candidates = [...main.querySelectorAll(
      ".cali-page-heading, .cali-article-heading, .cali-hero, .nav-cards, .cali-section-heading, .cali-year-heading, .cali-list-grid > article, .cali-projects-heading, .cali-project-list > li, .cali-prose > *"
    )];

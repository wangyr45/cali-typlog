  --room-shelf-wood-front-top: oklch(0.79 0.05 74);
  --room-shelf-wood-grain: rgb(71 42 17 / 0.08);
  --room-shelf-wood-top-back: oklch(0.77 0.045 75);
  --room-shelf-wood-top-front: oklch(0.84 0.04 78);


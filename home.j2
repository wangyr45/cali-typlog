/* Keep the original archive rhythm at narrow widths. */
.cali-writing-heading { padding-bottom:28px; }
.cali-writing-heading h1 {
  color:var(--muted-foreground);
  font-family:ui-monospace,monospace;
  font-size:12px;
  font-weight:400;
  letter-spacing:.08em;
}
.cali-writing-heading h1::before { content:'// '; opacity:.6; }
.cali-writing-groups { display:flex; flex-direction:column; gap:32px; }
.cali-writing-year { position:relative; isolation:isolate; }
.cali-year-heading { font-size:14px; font-weight:500; color:var(--muted-foreground); padding-bottom:8px; }
.cali-writing-year .cali-list-grid { border-top:var(--border-hairline) solid var(--border); }
.ghost-folio {
  position:absolute; top:-12px; right:0; z-index:-1;
  width:108px; height:63px;
  color:color-mix(in oklab,var(--foreground) 5%,transparent);
  pointer-events:none; user-select:none;
}
.cali-shell h3.blog-row-title { margin:0; }
.blog-row-date { flex:none; font-variant-numeric:tabular-nums; }
.blog-row-title { text-wrap:initial; }
.cali-credit { color:var(--muted-foreground); }
.cali-credit a { text-decoration:underline; text-underline-offset:3px; }
.nc-polaroid-loaded::before { visibility:hidden; }
.nc-polaroid img { position:absolute; top:3px; left:3px; width:36px; height:30px; }
@media(max-width:639px) {
  .nav-cards { margin-inline:-8px; }
  .cali-footer { padding-bottom:calc(110px + env(safe-area-inset-bottom)); }
}

/* Editorial identity and a quiet spectrum for the opening line. */
.cali-motto { line-height:1.8; }
.cali-motto span { color:#726582; }
@supports ((background-clip:text) or (-webkit-background-clip:text)) {
  .cali-motto span {
    background:linear-gradient(110deg,#a75564 0%,#946747 21%,#75763d 40%,#417b70 59%,#526e9b 78%,#8b6592 100%);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    -webkit-box-decoration-break:clone;
    box-decoration-break:clone;
  }
  .dark-theme .cali-motto span {
    background-image:linear-gradient(110deg,#df9daa 0%,#d8b28f 21%,#bdc38d 40%,#93c5b8 59%,#9db9dc 78%,#c6a5d2 100%);
  }
}
.cali-subscribe-link {
  display:inline; padding:2px 0; border:0; border-bottom:1px solid var(--border);
  border-radius:0; background:transparent; color:var(--foreground);
  text-decoration:none; text-underline-offset:4px;
}
.cali-subscribe-link span { font-size:.9em; margin-left:2px; }
.cali-subscribe-link:active { opacity:.65; }
.cali-colophon { align-items:baseline; flex-wrap:wrap; gap:10px 16px; }
.cali-colophon-links { display:flex; align-items:baseline; flex-wrap:wrap; gap:6px 18px; }
.cali-colophon-links>span { white-space:nowrap; }
.cali-credit a { text-decoration:none; }
.cali-portrait img {
  filter:grayscale(1) contrast(1.08);
  -webkit-mask-image:linear-gradient(to right,transparent,#000 10%,#000 90%,transparent),linear-gradient(to bottom,#000 86%,transparent);
  mask-image:linear-gradient(to right,transparent,#000 10%,#000 90%,transparent),linear-gradient(to bottom,#000 86%,transparent);
  -webkit-mask-composite:source-in;
  mask-composite:intersect;
}
.cali-portrait canvas { position:absolute; inset:0; width:100%; height:100%; display:block; }
.cali-portrait-monogram { border-radius:0; background:transparent; }
@media(hover:hover) and (pointer:fine) {
  .cali-subscribe-link:hover { border-color:var(--foreground); }
  .cali-credit a:hover { text-decoration:underline; }
}
@media(max-width:639px) {
  .cali-introduction h1 { font-size:24px; }
  .cali-introduction p { font-size:14px; }
  .cali-colophon { font-size:11px; }
  .cali-colophon-links { gap:6px 14px; }
}
@media(forced-colors:active) {
  .cali-motto span { background:none; color:CanvasText; }
  .cali-subscribe-link { border-color:ButtonText; }
}

.cali-portrait-ready>img { opacity:0; }
.cali-portrait-ready .cali-portrait-monogram { visibility:hidden; }

/* Projects keep the compact list proportions of cali.so. */
.project-row {
  display: grid;
  grid-template-columns: 2.75rem minmax(0, 9rem) minmax(0, 1fr);
  align-items: start;
  gap: 0.25rem 1rem;
  min-height: 4.75rem;
  padding-block: 0.875rem;
  font-size: 0.875rem;
}

.page-introduction {
  color: var(--gray-10, var(--foreground));
  font-size: 0.875rem;
  line-height: 1.7;
}

.project-row:focus-visible {
  border-radius: 2px;
  outline: 1px solid var(--focus-ring, var(--signal));
  outline-offset: 3px;
}

.project-icon-frame {
  position: relative;
  display: grid;
  width: 2.75rem;
  height: 2.75rem;
  place-items: center;
  isolation: isolate;
}

.project-icon-frame::before {
  position: absolute;
  inset: 0;
  color: var(--foreground);
  background:
    linear-gradient(currentColor, currentColor) left top / 7px var(--border-hairline) no-repeat,
    linear-gradient(currentColor, currentColor) left top / var(--border-hairline) 7px no-repeat,
    linear-gradient(currentColor, currentColor) right top / 7px var(--border-hairline) no-repeat,
    linear-gradient(currentColor, currentColor) right top / var(--border-hairline) 7px no-repeat,
    linear-gradient(currentColor, currentColor) left bottom / 7px var(--border-hairline) no-repeat,
    linear-gradient(currentColor, currentColor) left bottom / var(--border-hairline) 7px no-repeat,
    linear-gradient(currentColor, currentColor) right bottom / 7px var(--border-hairline) no-repeat,
    linear-gradient(currentColor, currentColor) right bottom / var(--border-hairline) 7px no-repeat;
  content: '';
  opacity: 0;
  transform: scale(0.82);
  transition:
    opacity 150ms ease,
    transform 300ms var(--ease-spring);
}

.project-icon {
  position: relative;
  z-index: 1;
  width: 2.25rem;
  height: 2.25rem;
  border-radius: 0.5rem;
  object-fit: cover;
  box-shadow: 0 0 0 var(--border-hairline) color-mix(in oklab, var(--foreground) 10%, transparent);
  transition: transform 300ms var(--ease-spring);
}

.project-identity {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.125rem;
  line-height: 1.4;
}

.project-name {
  max-width: 100%;
  color: var(--gray-11, var(--foreground));
  text-wrap: balance;
}

.project-domain {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: color 150ms ease;
}

.project-description {
  min-width: 0;
  color: var(--gray-8, var(--muted-foreground));
  line-height: 1.55;
  text-wrap: balance;
}

@media (hover: hover) and (pointer: fine) {
  .project-row:hover .project-icon-frame::before {
    opacity: 0.34;
    transform: scale(1);
  }

  .project-row:hover .project-icon {
    transform: translateY(-1px);
  }

  .project-row:hover .project-domain {
    color: var(--foreground);
  }
}

.project-row:focus-visible .external-label .external-mark {
  opacity: 0.6;

{% from "macros.j2" import render_social_icons %}
{% set zh = (site.primary_lang|default('en')).startswith('zh') %}
{% set defaults = {"intro": ["喜欢阅读，保持好奇。在这里记录读书、生活与日常思考。", "比起更新频率，我更在意写下的内容。愿这些文字，成为继续思考的起点。"], "portrait": "asset:hero-portrait.png", "projects_intro": "从阅读到记录，把日常里的小需求，慢慢做成好用的工具。", "projects": [{"title": "识古", "platform": "Chrome 插件", "description": "让古文更易读，支持翻译、解析与笔记摘录。", "url": "https://chromewebstore.google.com/detail/识古-古文翻译与文言文阅读助手/bplgmmnbplpajgpenahngicnjnenoaph", "icon": "https://lh3.googleusercontent.com/zPwPHwvyXi_bd31eJcdsI_0RAQA4wafN3o384u3b6_zzWuk6XRqIQnvkX9gTp6Ko674jv50i7RucOtbNugcNoI0-Ovw=s60"}, {"title": "DockPic", "platform": "macOS · App Store", "description": "一款可爱、好用的 macOS 图床应用。", "url": "https://apps.apple.com/us/app/dockpic-可爱-好用的图床应用/id6792192394", "icon": "asset:dockpic.png"}, {"title": "portus", "platform": "iOS · App Store", "description": "收下文字、链接与片刻灵感，送往常用的笔记工具。", "notice": "美区等地区上架，中国大陆区暂未上架。", "url": "https://apps.apple.com/us/app/portus-一键将灵感存入各大笔记软件/id6797192583", "icon": "asset:portus.png"}], "records": [], "books": [], "recent_count": 10, "recent_title": "", "records_title": "", "books_title": "", "show_toc": true, "show_cover": true, "support_qr": "asset:support.png", "wechat_qr": "asset:wechat-backup.png"} %}
{% set asset_base = static_url|default("https://cdn.jsdelivr.net/gh/wangyr45/cali-typlog@0.7.0/", true) %}
{% set supplied = query.config('cali-typlog') %}
{% set supplied = supplied if supplied is mapping else {} %}
{% set config = namespace(intro=defaults.intro, portrait=defaults.portrait,
  recent_count=defaults.recent_count, recent_title=defaults.recent_title,
  records=defaults.records, books=defaults.books, projects=defaults.projects,
  projects_intro=defaults.projects_intro, support_qr=defaults.support_qr, wechat_qr=defaults.wechat_qr,
  records_title=defaults.records_title, books_title=defaults.books_title,
  show_toc=defaults.show_toc, show_cover=defaults.show_cover) %}
{% if supplied.intro is string %}
  {% set config.intro = supplied.intro.splitlines() %}
{% elif supplied.intro is defined and supplied.intro is sequence and supplied.intro is not mapping %}
  {% set config.intro = supplied.intro|select('string')|list %}
{% endif %}
{% if supplied.portrait is string %}{% set config.portrait = supplied.portrait %}{% endif %}
{% if supplied.support_qr is string %}{% set config.support_qr = supplied.support_qr %}{% endif %}
{% if supplied.wechat_qr is string %}{% set config.wechat_qr = supplied.wechat_qr %}{% endif %}
{% if supplied.recent_count is number and supplied.recent_count == supplied.recent_count and supplied.recent_count is not sameas true and supplied.recent_count is not sameas false %}
  {% set config.recent_count = ([30, [1, supplied.recent_count]|max]|min)|int %}
{% endif %}
{% if supplied.recent_title is string %}{% set config.recent_title = supplied.recent_title %}{% endif %}
{% if supplied.records_title is string %}{% set config.records_title = supplied.records_title %}{% endif %}
{% if supplied.books_title is string %}{% set config.books_title = supplied.books_title %}{% endif %}
{% if supplied.projects_intro is string %}{% set config.projects_intro = supplied.projects_intro %}{% endif %}
{% if supplied.projects is defined and supplied.projects is sequence and supplied.projects is not string and supplied.projects is not mapping %}
  {% set config.projects = supplied.projects|select('mapping')|list %}
{% endif %}
{% if supplied.records is defined and supplied.records is sequence and supplied.records is not string and supplied.records is not mapping %}
  {% set config.records = supplied.records|select('mapping')|list %}
{% endif %}
{% if supplied.books is defined and supplied.books is sequence and supplied.books is not string and supplied.books is not mapping %}
  {% set config.books = supplied.books|select('mapping')|list %}
{% endif %}
{% if supplied.show_toc is sameas true or supplied.show_toc is sameas false %}
  {% set config.show_toc = supplied.show_toc %}
{% endif %}
{% if supplied.show_cover is sameas true or supplied.show_cover is sameas false %}
  {% set config.show_cover = supplied.show_cover %}
{% endif %}

{% set valid = namespace(records=[], books=[]) %}
{% for item in config.records %}
  {% if item is mapping and item.title is string and item.title|trim %}{% set valid.records = valid.records + [item] %}{% endif %}
{% endfor %}
{% for item in config.books %}
  {% if item is mapping and item.title is string and item.title|trim %}{% set valid.books = valid.books + [item] %}{% endif %}
{% endfor %}
{% set config.records = valid.records %}
{% set config.books = valid.books %}

{% macro public_url(value) -%}
  {%- if value is string -%}
    {%- set value = value|trim -%}
    {%- set normalized = value|lower -%}
    {%- if value.split()|join('') == value and '\\' not in value and '\x00' not in value -%}
      {%- if normalized.startswith('https://') or normalized.startswith('http://') -%}
        {%- set authority = value.split('://', 1)[1].split('/', 1)[0].split('?', 1)[0].split('#', 1)[0] -%}
        {%- if authority and not authority.startswith(':') and '@' not in authority -%}{{- value -}}{%- endif -%}
      {%- elif value.startswith('/') and not value.startswith('//') -%}
        {{- value -}}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endmacro %}
{% macro image_url(value) -%}
  {%- if value in ['asset:hero-portrait.png', 'asset:dockpic.png', 'asset:portus.png', 'asset:wechat-backup.png', 'asset:support.png'] -%}
    {{- asset_base.rstrip('/') ~ '/assets/' ~ value[6:] -}}
  {%- else -%}{{- public_url(value) -}}{%- endif -%}
{%- endmacro %}
{% set portrait_url = image_url(config.portrait)|trim %}
{% set portrait_url = portrait_url or (site.logo.src if site.logo else '') %}
{% set dock_portrait_url = site.logo.src if site.logo else '' %}
{% set project_entries = namespace(items=[]) %}
{% for item in config.projects %}
  {% if item.title is string and item.title|trim and public_url(item.url)|trim %}
    {% set project_entries.items = project_entries.items + [item] %}
  {% endif %}
{% endfor %}
{% set config.projects = project_entries.items %}
{% set projects_url = linkify('/') ~ '#projects' %}

{% set labels = {'home': '首页' if zh else 'Home', 'projects': '项目' if zh else 'Projects', 'archive': '文章归档' if zh else 'Archive', 'recent': '写作' if zh else 'Recent writing', 'subscribe': '订阅更新' if zh else 'Subscribe', 'search': '搜索文章' if zh else 'Search articles', 'topics': '阅读主题' if zh else 'Topics', 'empty': '暂时没有文章。' if zh else 'No articles yet.', 'menu': '导航与偏好' if zh else 'Navigation and preferences', 'toc': '本文目录' if zh else 'On this page', 'skip': '跳至正文' if zh else 'Skip to content', 'previous': '上一页' if zh else 'Previous', 'next': '下一页' if zh else 'Next', 'dark': '深色模式' if zh else 'Dark mode', 'protected': '受保护文章' if zh else 'Protected article'} %}


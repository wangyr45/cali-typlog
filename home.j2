      if (candidate.complete && candidate.naturalWidth > 0) ready();
    }

    source.addEventListener("error", retainFallback, {once: true});
    source.addEventListener("load", start, {once: true});
    if (source.complete) start();
  });
})();
(() => {
  "use strict";

  const projects = document.getElementById("projects");
  if (!projects || !projects.classList.contains("cali-projects-view")) return;

  const main = document.getElementById("cali-main");
  const menu = document.querySelector(".cali-preferences");
  const homeLinks = document.querySelectorAll("[data-cali-home-link]");
  const projectLinks = document.querySelectorAll("[data-cali-projects-link]");
  const homeTitle = document.title;
  const projectTitle = projects.dataset.pageTitle || homeTitle;

  function isProjects() {
    try {
      return decodeURIComponent(window.location.hash.slice(1)) === "projects";
    } catch {
      return false;
    }
  }

  function setCurrent(links, current) {
    links.forEach((link) => {
      if (current) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  }

  function updatePage(active) {
    document.title = active ? projectTitle : homeTitle;
    setCurrent(homeLinks, !active);
    setCurrent(projectLinks, active);
  }

  let active = isProjects();
  updatePage(active);

  document.addEventListener("click", (event) => {
    if (!active || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.target.closest?.("a.cali-skip, a[data-cali-projects-link]");
    if (!link || link.hasAttribute("download") || (link.target && link.target !== "_self")) return;
    if (link.matches(".cali-skip")) {
      // A skip link must not replace the fragment that selects this view.
      event.preventDefault();
      if (menu) menu.open = false;
      projects.focus({preventScroll: false});
    } else if (menu?.open) {
      menu.open = false;
    }
  });

  window.addEventListener("hashchange", () => {
    const next = isProjects();
    if (next === active) return;
    active = next;
    updatePage(active);
    if (menu) menu.open = false;
    // Preserve the browser's fragment scroll and history restoration.
    const target = active ? projects : main;
    if (target) target.focus({preventScroll: true});
  });
})();
(() => {
  "use strict";

  const dock = document.querySelector(".dock");
  if (dock) {
    const tip = document.createElement("span");
    tip.className = "cali-floating-tip";
    tip.id = "cali-dock-tip";
    tip.setAttribute("role", "tooltip");
    tip.hidden = true;
    document.body.append(tip);
    let active;
    let previousDescription;

    function hide() {
      if (active) {
        if (previousDescription) active.setAttribute("aria-describedby", previousDescription);
        else active.removeAttribute("aria-describedby");
      }
      active = null;
      tip.hidden = true;
    }

    function show(item) {
      const label = item.querySelector(".dock-label")?.textContent.trim();
      if (!label) return;
      hide();
      active = item;
      previousDescription = item.getAttribute("aria-describedby");
      tip.textContent = label;
      tip.hidden = false;
      const box = item.getBoundingClientRect();
      const width = tip.getBoundingClientRect().width;
      const height = tip.getBoundingClientRect().height;
      tip.style.left = `${Math.max(10, Math.min(box.left + box.width / 2 - width / 2, window.innerWidth - width - 10))}px`;
      tip.style.top = `${Math.max(8, box.top - height - 12)}px`;
      item.setAttribute("aria-describedby", [previousDescription, tip.id].filter(Boolean).join(" "));
    }

    dock.querySelectorAll(".dock-item").forEach((item) => {
      item.addEventListener("pointerenter", (event) => { if (event.pointerType !== "touch") show(item); });
      item.addEventListener("pointerleave", () => { if (document.activeElement !== item) hide(); });
      item.addEventListener("focus", () => show(item));
      item.addEventListener("blur", hide);
      item.addEventListener("click", hide);
      item.removeAttribute("title");
    });
    dock.dataset.tipsReady = "true";
    window.addEventListener("resize", hide);
    window.addEventListener("scroll", hide, {capture: true, passive: true});
    document.addEventListener("keydown", (event) => { if (event.key === "Escape") hide(); });
  }

  document.querySelectorAll(".cali-social a").forEach((link) => {
    const label = link.getAttribute("title") || link.getAttribute("aria-label") || link.textContent.trim();
    if (!label) return;
    const icon = link.querySelector("svg, .icon");
    const name = document.createElement("span");
    name.className = "contact-label";
    name.textContent = label === "Twitter" ? "X / Twitter" : label;
    const arrow = document.createElement("span");
    arrow.className = "contact-arrow";
    arrow.textContent = "↗";
    arrow.setAttribute("aria-hidden", "true");
    link.replaceChildren(...(icon ? [icon] : []), name, arrow);
    link.removeAttribute("title");
    const preview = document.createElement("span");
    preview.className = "contact-preview";
    preview.setAttribute("aria-hidden", "true");
    const heading = document.createElement("strong");
    heading.textContent = name.textContent;
    const address = document.createElement("span");
    try {
      const url = new URL(link.href, window.location.href);
      // Show only the destination, never query tokens from a saved link.
      address.textContent = url.protocol === "mailto:" ? url.pathname : url.hostname + (url.pathname === "/" ? "" : url.pathname);
    } catch { address.textContent = name.textContent; }
    preview.append(heading, address);
    link.append(preview);
    link.addEventListener("pointerenter", () => link.classList.remove("contact-dismissed"));
    link.addEventListener("focus", () => link.classList.remove("contact-dismissed"));
    link.addEventListener("keydown", (event) => { if (event.key === "Escape") link.classList.add("contact-dismissed"); });
  });

  const dialog = document.querySelector(".cali-qr-dialog");
  if (!dialog || typeof dialog.showModal !== "function") return;
  const image = dialog.querySelector("[data-qr-full]");
  const title = dialog.querySelector("h2");
  const original = dialog.querySelector("[data-qr-original]");
  let opener;
  document.querySelectorAll("[data-cali-qr]").forEach((link) => {
    link.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      image.src = link.href;
      image.alt = link.dataset.qrTitle;
      title.textContent = link.dataset.qrTitle;
      original.href = link.href;
      try { dialog.showModal(); } catch { return; }
      opener = link;
      event.preventDefault();
    });
  });
  dialog.addEventListener("click", (event) => {
    if (event.target !== dialog) return;
    const box = dialog.getBoundingClientRect();
    if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close();
  });
  dialog.addEventListener("close", () => { if (opener) opener.focus({preventScroll: true}); });
})();
</script>{% endblock %}
{% block body %}
<div class="cali-shell">
  {{ header() }}
  <main id="cali-main" tabindex="-1">
    {{ projects_view() }}
    <div class="cali-home-view">
    {% set subjects = query.latest_subjects(count=config.recent_count) %}
    <section class="cali-hero">
      <div class="cali-introduction">
        <h1>{{ site.name }}<span class="cali-pixel-mark" aria-hidden="true">▗▖<br>▝▘</span></h1>
        {% if site.summary %}<p class="cali-motto"><span>{{ site.summary }}</span></p>{% endif %}
        {% for paragraph in config.intro %}{% if paragraph|trim %}<p>{{ paragraph }}</p>{% endif %}{% endfor %}
        {% if features.subscriber %}<p class="cali-intro-subscribe">{{ '如果这些文字与你有所共鸣，欢迎' if zh else 'If these words resonate with you, ' }}<button type="button" class="js-subscribe cali-subscribe-link">{{ labels.subscribe }} <span aria-hidden="true">↗</span></button>{{ '。' if zh else '.' }}</p>{% endif %}
      </div>
      <div class="cali-portrait" aria-label="{{ site.name }}">
        <span class="cali-portrait-monogram" aria-hidden="true">{{ site.name[:1] }}</span>
        {% if portrait_url %}
          <img data-cali-image src="{{ portrait_url }}" alt="{{ site.name }}" width="240" height="240" fetchpriority="high">
          <canvas data-cali-portrait width="480" height="480" hidden aria-hidden="true"></canvas>
        {% endif %}
      </div>
    </section>

    {% set cards = namespace(items=(site.primary_links|default([], true))[:3]) %}
    {% if not cards.items %}{% set cards.items = [{'title': labels.archive, 'url': linkify(site.list_url)}] %}{% endif %}
    {% if cards.items %}
    <nav class="nav-cards" style="grid-template-columns:repeat({{ cards.items|length }},minmax(0,1fr))" aria-label="{{ labels.menu }}">
      {% for nav in cards.items %}
      {% set path = local_path(nav.url)|trim %}
      {% set album = path == '/moments' or path.startswith('/moments/') %}
      {% set list_path = local_path(linkify(site.list_url))|trim %}
      {% set writing = path and (path.rstrip('/') == list_path.rstrip('/') or path.startswith('/tags/')) %}
      <a class="nav-card" href="{{ nav.url }}"{% if album %} data-cali-album{% elif writing %} data-cali-collection="{{ nav.url }}" data-cali-list-path="{{ list_path }}"{% endif %}{% if nav.blank %} target="_blank" rel="noopener noreferrer"{% endif %}>
        <span class="nc-vignette" aria-hidden="true">
          {% if album or writing %}
            {% for i in range(3) %}<span class="nc-polaroid nc-polaroid-placeholder" style="--i:{{ i }}"></span>{% endfor %}
          {% else %}
            <span class="nc-project-icon">
              <svg class="nc-construction-guides" viewBox="0 0 52 52"><g class="nc-guide-solid" fill="none"><path d="M26 0V52M0 26H52M0 0L52 52M52 0L0 52"/><circle cx="26" cy="26" r="21"/></g></svg>
              <span class="nc-project-mark">{{ platform_icon(platform(nav.url)|trim) }}</span>
            </span>
          {% endif %}
        </span>
        <span class="nc-label">{{ nav.title }}</span>
        {% if album %}<span class="nc-sub">{{ '浏览相册' if zh else 'View photos' }}</span>{% endif %}
      </a>
      {% endfor %}
    </nav>
    {% endif %}

    <section class="cali-section">
      <div class="cali-section-heading">
        {{ tag(1, config.recent_title or labels.recent) }}
        <a href="{{ linkify(site.list_url) }}">{{ '查看全部' if zh else 'View all' }} ↗</a>
      </div>
      {{ writing_list(subjects) }}
    </section>
    {{ shelf(config.records, 'records', 2, config.records_title or ('循环播放中' if zh else 'On rotation')) }}
    {{ shelf(config.books, 'books', 2+(1 if config.records else 0), config.books_title or ('珍藏书架' if zh else 'Books I love')) }}
    </div>
  </main>
  {{ footer() }}
</div>
{% endblock %}

}
.cali-skip:focus {
  top:10px;
}
.cali-shelf {
  display:flex;
  align-items:end;
  overflow-x:auto;
  overflow-y:hidden;
  padding:15px 8px 18px;
  perspective:1000px;
  isolation:isolate;
  border-bottom:1px solid var(--border);
}
.cali-sleeve {
  position:relative;
  flex:0 0 30px;
  height:200px;
  border:0;
  padding:0;
  background:transparent;
  color:var(--foreground);
  transition:flex-basis .45s var(--ease-spring);
  text-align:left;
}
.cali-spine {
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  writing-mode:vertical-rl;
  padding:12px 6px;
  border:1px solid var(--border);
  background:var(--paper);
  box-shadow:inset -3px 0 4px #00000010;
  font-size:12px;
  overflow:hidden;
}
.cali-front {
  display:flex;
  align-items:center;
  justify-content:center;
  position:absolute;
  inset:0;
  overflow:hidden;
  background:var(--paper);
  border:1px solid var(--border);
  transform-origin:left;
  transform:rotateY(-88deg);
  backface-visibility:hidden;
  transition:transform .45s var(--ease-spring);
  width:142px;
  box-shadow:3px 3px 6px #00000012;
}
.cali-front img {
  width:100%;
  height:100%;
  object-fit:cover;
}
.cali-front>span {
  padding:20px;
  font-size:22px;
  font-family:serif;
}
.cali-sleeve[aria-pressed="true"] {
  flex-basis:156px;
}
.cali-sleeve[aria-pressed="true"] .cali-front {
  transform:rotateY(-12deg);
}
.cali-records .cali-sleeve {
  height:170px;
  flex-basis:35px;
}
.cali-records .cali-front {
  width:170px;
  transform:rotateY(-65deg);
}
.cali-records .cali-sleeve[aria-pressed="true"] {
  flex-basis:182px;
}
.cali-records .cali-sleeve[aria-pressed="true"] .cali-front {
  transform:rotateY(-8deg);
}
.cali-shelf-captions {
  min-height:44px;
  padding-top:12px;
  font-size:12px;
  color:var(--muted-foreground);

.cali-native-share,.cali-native-foot,.subject-license {
  margin-top:32px;
  font-size:13px;
  color:var(--muted-foreground);
}
.cali-sr-only {
  position:absolute;
  width:1px;
  height:1px;
  padding:0;
  margin:-1px;
  overflow:hidden;
  clip:rect(0,0,0,0);

}
.cali-prose h2 {
  font-size:21px;
  margin:2.1em 0 .75em;
  font-weight:600;
}
.cali-prose h3 {
  font-size:18px;
  margin:1.7em 0 .6em;
}
.cali-prose a {
  text-decoration:underline;
  text-underline-offset:4px;
}
.cali-prose blockquote {
  margin:24px 0;
  padding:0 20px;
  border-left:2px solid var(--border);

  font-family:ui-monospace,monospace;
  white-space:nowrap;
}
.blog-row-leader {
  flex:1;
  min-width:24px;
  height:1px;
  background:repeating-linear-gradient(to right,var(--border) 0 2px,transparent 2px 6px);
}
.print-thumb {
  display:grid;
  place-items:center;
  overflow:hidden;
  background:var(--paper);
}
.print-thumb img {
  width:100%;
  height:100%;
  object-fit:cover;
}
.print-lines {
  width:65%;
  height:55%;
  background:repeating-linear-gradient(to bottom,transparent 0 5px,var(--border) 5px 6px);
}
.dock-glass {
  backdrop-filter:blur(20px) saturate(1.4);
  -webkit-backdrop-filter:blur(20px) saturate(1.4);
}
.dock {
  width:max-content;
  max-width:calc(100vw - 24px);
}
.dock-rule,.cali-preferences {
  flex-shrink:0;
}
.dock-secondary {
  display:flex;
  align-items:center;
  gap:4px;
  min-width:0;
  max-width:240px;
  height:52px;
  overflow-x:auto;
  overscroll-behavior-x:contain;
  scrollbar-width:thin;
  scrollbar-color:var(--border) transparent;
  z-index:1;
}
.dock-secondary .dock-item {
  position:static;
}
.dock-secondary .dock-item:focus-visible {
  outline-offset:-3px;
}
.dock-secondary .dock-item[aria-current] {
  background:var(--muted);
}
.dock-secondary .dock-item[aria-current]::after {
  content:none;
}
.dock-secondary .dock-item:active {
  transform:none;
}
.dock-item {
  border:0;
  background:none;
  flex:none;
  cursor:pointer;
}
.dock-label {
  position:absolute;
  bottom:calc(100% + 14px);
  left:50%;
  transform:translateX(-50%);
  padding:3px 9px;
  border-radius:6px;
  width:max-content;
  max-width:min(280px, calc(100vw - 40px));
  white-space:normal;
  overflow-wrap:anywhere;
  text-align:center;
  font-size:12px;
  background:var(--foreground);
  color:var(--background);
  opacity:0;
  pointer-events:none;
  transition:opacity .15s;
}
.dock-item:hover>.dock-label,.dock-item:focus-visible>.dock-label {
  opacity:1;
}
.dock-item[aria-current]::after {
  position:absolute;
  bottom:1px;
  width:3px;
  height:3px;
  border-radius:50%;
  background:currentColor;
  content:"";
}
.dock-avatar {
  display:grid;
  place-items:center;
  font-size:13px;
  background:var(--gray-3);
}
.cali-preferences summary {
  list-style:none;
}
.cali-preferences summary::-webkit-details-marker {
  display:none;
}
.cali-preferences-panel {
  position:absolute;
  bottom:64px;
  right:-6px;
  width:280px;
  padding:16px;
  background:var(--background);
  border:1px solid var(--border);
  border-radius:14px;
  box-shadow:var(--shadow-medium);
  max-height:65vh;
  overflow:auto;
}
.cali-preferences-panel>p {
  font-size:12px;
  color:var(--muted-foreground);
  margin-bottom:12px;
}
.cali-preferences-panel nav {
  display:flex;
  flex-direction:column;
  gap:6px;
  margin-top:14px;
  border-top:1px solid var(--border);
  padding-top:10px;
}
.cali-theme-control {
  display:flex;
  justify-content:space-between;
  align-items:center;
  min-height:40px;
  cursor:pointer;
}
.cali-theme-control input {
  accent-color:var(--foreground);
  width:18px;
  height:18px;
}
.cali-search {
  display:block;
  width:100%;
  border:1px solid var(--border);
  border-radius:6px;
  padding:9px;
  background:var(--gray-2);
  color:var(--foreground);
  margin:10px 0;
}
.cali-button {
  width:100%;
  padding:8px;
  border:1px solid var(--border);
  border-radius:6px;
  color:var(--foreground);
  background:var(--gray-2);
}
.cali-footer {
  display:grid;
  grid-template-columns:1fr 1fr;
  margin-top:56px;
  padding:32px 0 110px;
  border-top:1px solid var(--border);
  font-size:12px;
}
.cali-footer h2 {
  font-size:12px;
  color:var(--muted-foreground);
  font-weight:400;
  letter-spacing:.08em;
  margin-bottom:12px;
}
.cali-footer nav {
  display:flex;
  flex-direction:column;
  align-items:start;
  gap:5px;
}
.cali-footer .cali-social svg {
  width:16px;
  height:16px;
}
.cali-colophon {
  grid-column:1/-1;
  display:flex;
  justify-content:space-between;
  color:var(--muted-foreground);
  padding-top:32px;
}
.cali-page-heading {
  padding-bottom:30px;
}
.cali-page-heading h1 {
  font-size:24px;
  font-weight:600;
  letter-spacing:-.025em;
}
.cali-page-heading p {
  margin-top:12px;
  color:var(--muted-foreground);
}
.cali-pagination,.cali-years {
  display:flex;
  flex-wrap:wrap;
  gap:24px;
  margin-top:30px;
  font-size:13px;
}
.cali-years a[aria-current] {
  text-decoration:underline;
}
.cali-pagination {
  justify-content:space-between;
}
.cali-empty {
  color:var(--muted-foreground);
  padding:24px 0;
}
.cali-back {
  font-size:12px;
  color:var(--muted-foreground)!important;
  display:inline-block;
  margin-bottom:32px;
}
.cali-article-heading h1 {
  font-size:24px;
  line-height:1.4;
  font-weight:600;
  letter-spacing:-.025em;
  margin:24px 0 12px;
}
.cali-article-heading .p-summary {

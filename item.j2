</style>{% endblock %}
{% block script %}<script>
(() => {
  "use strict";

  const menu = document.querySelector(".cali-mobile-nav");
  if (menu) {
    const summary = menu.querySelector("summary");
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        summary.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target)) menu.open = false;
    });
    document.addEventListener("focusin", (event) => {
      if (menu.open && !menu.contains(event.target)) menu.open = false;
    });
  }

  document.querySelectorAll("[data-cali-image]").forEach((image) => {
    const hideFailedImage = () => { image.hidden = true; };
    image.addEventListener("error", hideFailedImage);
    // Cached failures can occur before this script runs.
    if (image.complete && image.naturalWidth === 0) hideFailedImage();
  });

  document.querySelectorAll("[data-collection]").forEach((collection) => {
    const shelf = collection.querySelector(".cali-shelf");
    const captionGroup = collection.querySelector(".cali-shelf-captions");
    const fallback = collection.querySelector(".cali-collection-list");
    const buttons = [...collection.querySelectorAll(".cali-sleeve")];
    const captions = [...collection.querySelectorAll(".cali-shelf-captions p")];
    if (!shelf || !captionGroup || !fallback || !buttons.length || buttons.length !== captions.length) return;

    function select(index, reveal = false) {
      buttons.forEach((button, i) => {
        button.setAttribute("aria-pressed", String(i === index));
        button.tabIndex = i === index ? 0 : -1;
      });
      captions.forEach((caption, i) => { caption.hidden = i !== index; });
      if (reveal) {
        // Scroll only the shelf. Do not move the page when switching a cover.
        const frame = shelf.getBoundingClientRect();
        const target = buttons[index].getBoundingClientRect();
        const offset = target.left < frame.left ? target.left - frame.left : Math.max(0, target.right - frame.right);
        if (offset) shelf.scrollBy({left: offset, behavior: "auto"});
      }
    }

    buttons.forEach((button, index) => {
      button.addEventListener("click", () => select(index));
      button.addEventListener("keydown", (event) => {
        let next;
        if (event.key === "ArrowRight") next = (index + 1) % buttons.length;
        else if (event.key === "ArrowLeft") next = (index + buttons.length - 1) % buttons.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = buttons.length - 1;
        else return;
        event.preventDefault();
        select(next, true);
        buttons[next].focus({preventScroll: true});
      });
      button.disabled = false;
    });
    select(0);
    shelf.hidden = false;
    captionGroup.hidden = false;
    fallback.hidden = true;
  });

  const content = document.querySelector(".cali-prose");
  const toc = document.querySelector(".cali-toc");
  if (!content || !toc) return;
  const nav = toc.querySelector("nav");
  const details = toc.querySelector("details");
  let headings = [];
  let links = [];
  let headingLabels = [];
  let scheduled = false;

  function updateActive() {
    scheduled = false;
    if (!headings.length) return;
    let active = 0;
    headings.forEach((heading, index) => {
      if (heading.getBoundingClientRect().top <= 120) active = index;
    });
    links.forEach((link, index) => {
      if (index === active) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  }

  function scheduleActive() {
    if (scheduled) return;
    scheduled = true;
    window.requestAnimationFrame(updateActive);
  }

  function rebuild() {
    // Index only content that Typlog has rendered for the current visitor.
    const next = [...content.querySelectorAll("h2, h3")].filter((heading) => heading.textContent.trim());
    // Player timers and embeds can change without changing the article outline.
    if (next.length === headings.length && next.every((heading, index) => heading === headings[index] && heading.textContent === headingLabels[index])) return;
    headings = next;
    headingLabels = headings.map((heading) => heading.textContent);
    nav.replaceChildren();
    links = [];
    toc.hidden = headings.length < 2;
    if (toc.hidden) return;
    headings.forEach((heading, index) => {
      if (!heading.id || document.getElementById(heading.id) !== heading) {
        let candidate = `cali-section-${index + 1}`;
        while (document.getElementById(candidate)) candidate += "-x";
        heading.id = candidate;
      }
      const link = document.createElement("a");
      link.href = `#${encodeURIComponent(heading.id)}`;
      link.textContent = heading.textContent;
      link.dataset.depth = heading.tagName.slice(1);
      nav.append(link);
      links.push(link);
    });
    scheduleActive();
  }

  details.open = !window.matchMedia("(max-width: 1050px)").matches;
  rebuild();
  window.addEventListener("scroll", scheduleActive, {passive: true});
  window.addEventListener("resize", scheduleActive, {passive: true});
  // A protected article may be rendered after the visitor signs in.
  if ("MutationObserver" in window) {
    new MutationObserver(rebuild).observe(content, {childList: true, subtree: true, characterData: true});
  }
})();
</script>{% endblock %}
{% block body %}
<div class="cali-shell">
  {{ header() }}
  <main id="cali-main" class="cali-container cali-detail" tabindex="-1">
    <a class="cali-back" href="{{ linkify(site.list_url) }}">← {{ labels.archive }}</a>
    <div class="cali-article-layout">
      {% if config.show_toc %}<aside class="cali-toc" hidden><details open><summary>{{ labels.toc }}</summary><nav aria-label="{{ labels.toc }}"></nav></details></aside>{% endif %}
      <div class="cali-article-column">
        <article class="h-entry cali-article" itemscope itemtype="https://schema.org/Article">
          <header class="cali-article-heading">
            {% if config.show_cover and page.cover and page.cover.src and page.visibility|default('public') == 'public' %}<img data-cali-image class="cali-article-cover u-photo" src="{{ page.cover.src|thumbnail('l') }}" alt="" width="{{ page.cover.width }}" height="{{ page.cover.height }}" fetchpriority="high">{% endif %}

            <h1 class="p-name" itemprop="headline">{{ page.title }}</h1>
            {% if page.subtitle %}<p class="p-summary">{{ page.subtitle }}</p>{% endif %}
            <div class="cali-meta">{% if page.published_at %}<time class="dt-published" datetime="{{ page.published_at|xmldatetime }}" itemprop="datePublished">{{ page.published_at.strftime('%Y / %m / %d') }}</time>{% endif %}{% if page.type == 'audio' and page.duration %}<span>{{ page.duration }}</span>{% endif %}</div>
            {% if page.tags %}<div class="cali-tags">{% for tag in page.tags %}<a class="p-category" href="{{ linkify(tag.url) }}">{{ tag.title }}</a>{% endfor %}</div>{% endif %}
          </header>
          <div class="e-content js-content cali-prose" itemprop="articleBody">
            {{ render_subject_content(site, page) }}
          </div>
          {{ render_subject_authors(site, page) }}
        </article>
        {% if page.type != 'page' %}{{ render_subject_license(site, page) }}{% endif %}
        <div class="cali-native-share">{% include "_snippets/subject_share.j2" %}</div>
        <div class="cali-native-foot">{% include "_snippets/subject_foot.j2" %}</div>
      </div>
    </div>
  </main>
  {{ footer() }}
</div>
{% endblock %}

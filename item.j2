}
.cali-shelf {
  display:flex;
  align-items:end;
  overflow-x:auto;
  overflow-y:hidden;
  padding:15px 8px 18px;
  perspective:1000px;
  isolation:isolate;
  border-bottom:1px solid var(--border);
}
.cali-sleeve {
  position:relative;
  flex:0 0 30px;
  height:200px;
  border:0;
  padding:0;
  background:transparent;
  color:var(--foreground);
  transition:flex-basis .45s var(--ease-spring);
